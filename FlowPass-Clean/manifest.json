{
  "manifest_version": 3,
  "name": "Google Flow Region Unlocker",
  "version": "1.0.0",
  "description": "Unlocks Google Flow in all countries by modifying client-side region entitlement checks.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Flow Region Unlocker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["engine.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
